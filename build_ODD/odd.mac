# Set the verbose
#/run/verbose 2

# Set the number of threads for multi-threading mode
/run/numberOfThreads  8

# Initialize
/run/initialize

# Set the nps
# lung
/odd/organ "9700 9900"
/odd/dir front
/run/beamOn 10000000

# breast
/odd/organ "6200 6300 6400 6500"
/odd/dir front
/run/beamOn 10000000

# RBM
/odd/organ "0 1400 1700 1500 2000 2100 2300 2500 2700 2900 3200 3000 3500 3600 3800 4000 4200 4400 4600 4800 5000 5200 5400 5600"
/odd/dir front
/run/beamOn 10000000

