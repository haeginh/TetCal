# Set the verbose
# Set TET model file prefixes before /run/initialize.
# The phantom prefix reads only [prefix].node.
# Other base phantom files are read as MRCP_AM.ele/.material/.dose/.RBMnBS/.DRF
# from the same directory as [prefix].node.
# Extra TET prefixes read only .ele/.node/.material and can be repeated.
#/tetcal/phantom ../phantoms/MRCP_AM_posture1_mod
#/tetcal/addTet ./parts/apron
#/tetcal/addTet ./parts/shield

/run/verbose 2

# Set the number of threads for multi-threading mode
/run/numberOfThreads  1

# Enable bremsstrahlung photon splitting in the phantom box region
/process/em/setSecBiasing eBrem phantomBoxRegion 100 100 MeV

# Initialize
/run/initialize

# external irradiation
/gun/particle e-
/external/dir AP
/gun/energy 0.1 MeV
/run/beamOn 10000

# internal source
/internal/surface 9500
/gun/energy 0.01 MeV
/run/beamOn 10000

/internal/surface "9700 9900"
/gun/energy 0.01 MeV
/run/beamOn 10000

/gun/particle e-
/internal/source 9500
/gun/energy 0.001 MeV
/run/beamOn 10000

/gun/particle gamma
/internal/source 13200
# Per-decay isotope source from IAEA LiveChart files generated in iaea_spectra/.
# Use instead of /spec/RADcodes and /spec/input when running isotope spectra.
#/spec/IAEA iaea_spectra I-131
/spec/RADcodes X G
/spec/input I-131.RAD
/run/beamOn 10000
